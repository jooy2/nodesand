{
  "compilerOptions": {
    "baseUrl": "lib",
    "target": "esnext",
    "module": "Preserve",
    "moduleDetection": "force",
    "lib": ["esnext"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules"]
}
