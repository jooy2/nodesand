{
  "name": "nodesand",
  "version": "1.0.0",
  "description": "Super Simple Node.js Sandbox",
  "private": true,
  "type": "module",
  "exports": "./index.js",
  "scripts": {
    "once": "tsx src/_preload",
    "watch": "tsx watch src/_preload",
    "build": "tsc --project tsconfig.json",
    "bench": "tsx src/_preload/bench.ts",
    "serve": "serve src/www",
    "www": "npm run serve",
    "dev": "npm run once",
    "test": "npm run once",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.mts,.cts src",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "reset": "git reset HEAD --hard && git clean -f -d -x -e '.idea/' -e 'node_modules/' -e 'dist/'",
    "reset:all": "npm run reset && npm i"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/nodesand.git"
  },
  "bugs": {
    "url": "https://github.com/jooy2/nodesand/issues"
  },
  "homepage": "https://github.com/jooy2/nodesand",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-n": "^17.23.2",
    "globals": "^17.3.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "serve": "^14.2.5",
    "tinybench": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ora": "^9.1.0"
  }
}
